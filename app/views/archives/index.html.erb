<% content_for(:title, "アーカイブ一覧") %>
<% breadcrumb :archives %>
<h1 class="text-center mb-5 mt-4">アーカイブ一覧</h1>

<div class="container">
  <div class="row">
    <% @archives.each do |archive| %>
      <div class="col-md-4 mb-4">
        <div class="card h-100 ">
          <% if archive.thumbnail_url.present? %>
            <%= link_to archive_path(archive) do %>
              <%= image_tag archive.thumbnail_url, class: "card-img-top" %>
            <% end %>
          <% end %>
          <div class="card-body">
            <p style="font-size: 24px; font-weight: bold; text-align: center;"><%= archive.title %></p>
            <p><strong>配信者名：</strong><%= archive.streamer_name %></p>
            <p><strong>再生時間：</strong><%= archive.duration_formatted %></p>
            <p><strong>開始日時：</strong><%= archive.started_at %></p>
            <p><strong>現在状況：</strong><%= t("enums.archive.status.#{archive.status}") %></p>
          </div>
        </div>
      </div>
    <% end %>
    <%= link_to new_archive_path, class: "btn btn-primary mb-4 mt-4" do %>
      <i class="bi bi-plus-circle"></i>　新しい動画を登録
    <% end %>
  </div>
</div>
