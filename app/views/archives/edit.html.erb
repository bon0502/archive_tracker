<h1 class="text-center mb-4 mt-4">アーカイブ編集</h1>

<div class="container pb-5">
  <div class="row justify-content-center">
    <div class="col-md-6">
      <div class="card">
        <div class="card-body">
          <%= form_with model: @archive, local: true do |f| %>
            <% if @archive.errors.any? %>
              <div class="alert alert-danger">
                <h2 class="h5"><%= @archive.errors.count %> 件のエラーが発生しました:</h2>
                <ul class="mb-0">
                  <% @archive.errors.full_messages.each do |message| %>
                    <li><%= message %></li>
                  <% end %>
                </ul>
              </div>
            <% end %>

            <div class="mb-3">
              <%= f.label :title, "タイトル", class: "form-label" %>
              <%= f.text_field :title, class: "form-control" %>
            </div>

            <div class="mb-3">
              <%= f.label :streamer_name, "配信者名", class: "form-label" %>
              <%= f.text_field :streamer_name, class: "form-control" %>
            </div>

            <div class="mb-3">
              <%= f.label :video_url, "動画URL", class: "form-label" %>
              <%= f.text_field :video_url, class: "form-control" %>
            </div>

            <div class="mb-3">
              <%= f.label :duration_seconds, "再生時間（秒）", class: "form-label" %>
              <%= f.number_field :duration_seconds, class: "form-control" %>
            </div>

            <div class="mb-3">
              <%= f.label :status, "ステータス", class: "form-label" %>
              <%= f.select :status, Archive.statuses.keys.map { |status| [t("enums.archive.status.#{status}"), status] }, {}, class: "form-control" %>
            </div>

            <div class="mb-3">
              <%= f.submit "更新", class: "btn btn-primary" %>
              <%= link_to "一覧に戻る", archives_path, class: "btn btn-secondary" %>
            </div>
           <% end %>
        </div>
      </div>
    </div>
  </div>
</div>
