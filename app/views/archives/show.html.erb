<% content_for(:title, @archive.title) %>
<% breadcrumb :archive, @archive %>

<h1 class="text-center mb-4 mt-4">アーカイブ詳細</h1>

<div class="container pb-5">
  <div class="row justify-content-center">
    <div class="col-md-6">
      <div class="card">
        <div class="card-body"
             data-controller="viewing-position"
             data-viewing-position-video-id-value="<%= @archive.youtube_video_id %>"
             data-viewing-position-start-seconds-value="<%= @viewing_position.current_position_seconds %>"
             data-viewing-position-save-url-value="<%= archive_viewing_position_path(@archive) %>">
          <div class="ratio ratio-16x9">
            <div data-viewing-position-target="player"></div>
          </div>
          <p style="font-size: 24px; font-weight: bold; text-align: center;"><%= @archive.title %></p>

          <p>
            現在位置：<span data-viewing-position-target="currentTime">00:00</span> /
            残り時間：<span data-viewing-position-target="remainingTime">00:00</span>
          </p>

          <div class="d-flex justify-content-between mb-3">
            <span>進歩状況</span>
          </div>
          <div class="progress mb-3">
            <div class="progress-bar" data-viewing-position-target="progressBar" role="progressbar" style="width: <%= @viewing_position.progress_percentage %>%">
              <%= @viewing_position.progress_percentage %>%
            </div>
          </div>
          <div class="mt-2">
            <%= link_to "編集", edit_archive_path(@archive), class: "btn btn-warning" %>
            <%= link_to "削除", archive_path(@archive), data: { turbo_method: :delete, turbo_confirm: "本当に削除しますか？" }, class: "btn btn-danger" %>
            <%= link_to "一覧に戻る", archives_path, class: "btn btn-secondary" %>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>
