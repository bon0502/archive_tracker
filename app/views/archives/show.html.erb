<h1 class="text-center mb-4 mt-4">アーカイブ詳細</h1>

<div class="container pb-5">
  <div class="row justify-content-center">
    <div class="col-md-6">
      <div class="card">
        <div class="card-body">
          <%= form_with model: @viewing_position, url: archive_viewing_position_path(@archive), method: :patch, data: { turbo: false } do |f| %>
            <div class="mb-3">
              <%= f.label :current_position_seconds, "視聴位置（秒）" %>
            </div>
            <div class="mb-3">
              <%= f.number_field :current_position_seconds, class: "form-control" %>
            </div>
            <div class="mb-3">
              <%= f.submit "保存する", class: "btn btn-primary" %>
            </div>
          <% end %>
            <p>残り時間: <%= @viewing_position.remaining_seconds %> 秒</p>
          <div class="d-flex justify-content-between mb-3">
            <span>進歩状況</span>
          </div>
          <div class="progress mb-3">
            <div class="progress-bar" role="progressbar" style="width: <%= @viewing_position.progress_percentage %>%">
              <%= @viewing_position.progress_percentage %>%
            </div>
          </div>
          <div class="d-flex justify-content-between">
            <%= link_to "一覧に戻る", archives_path, class: "btn btn-secondary" %>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>
