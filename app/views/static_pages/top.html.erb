<% flash.each do |message_type, message| %>
  <div class="alert alert-<%= message_type %>">
    <%= message %>
  </div>
<% end %>

<div class="top-wrapper">
  <div class="top-image">
    <%= image_tag 'topmozi.png', class: 'top_logo' %>
  </div>
  <div class="top-inner-text">
    <%= link_to archives_path, class: 'btn btn-primary large-btn' do %>
      <i class="bi bi-dpad"></i>　スタート　<i class="bi bi-dpad-fill"></i>
    <% end %>
  </div>
</div>
